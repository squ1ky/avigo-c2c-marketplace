# Server
SERVER_ADDRESS=:8082
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=db-listing
POSTGRES_PORT=5432
POSTGRES_USER=avigo_listings
POSTGRES_PASSWORD=listingpass
POSTGRES_DB=avigo_listings
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_MIGRATIONS_PATH=migrations
DATABASE_URL=postgres://avigo_listings:listingpass@db-listing:5432/avigo_listings?sslmode=disable

# MongoDB
MONGODB_URI=mongodb://mongo-listing:27017
MONGODB_DATABASE=listings_metadata
MONGODB_CONNECT_TIMEOUT=10s
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_TAGS_COLLECTION=tags
MONGODB_CATEGORIES_COLLECTION=categories
MONGODB_METADATA_COLLECTION=listing_metadata

# MinIO / S3
S3_REGION=us-east-1
S3_BUCKET=avigo-listings-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=minio:9000
S3_PUBLIC_URL=http://localhost:9000/avigo-listings-media
S3_USE_SSL=false                           
S3_MAX_FILE_SIZE=10485760                  # 10MB
S3_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_LISTINGS_EVENTS=listing.events
KAFKA_REQUIRED_ACKS=-1
KAFKA_GROUP_ID=listing-service
KAFKA_COMPRESSION=2
KAFKA_DIAL_TIMEOUT=10s
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s
KAFKA_RETRY_MAX=3
KAFKA_RETRY_BACKOFF=100ms

# Client
USER_SERVICE_ADDRESS=user-service:50051

GEMINI_API_KEY=AIzaSyCG7rxlhQqlDuh90VvK8e_2szLQMB87uos
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=10s
