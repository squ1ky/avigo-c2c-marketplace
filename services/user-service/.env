# Database
POSTGRES_USER=avigo_user
POSTGRES_PASSWORD=avigopass
POSTGRES_DB=avigo_user

DATABASE_URL=postgres://avigo_user:avigopass@db-user:5432/avigo_user?sslmode=disable
MIGRATIONS_PATH=internal/db/migrations

# Server
SERVER_ADDRESS=:8081

# Logging
LOG_LEVEL=debug

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_USER_EVENTS=user.events

# -1 (WaitForAll), 0 (NoResponse), 1 (WaitForLocal)
KAFKA_REQUIRED_ACKS=-1

# 0 (None), 1 (Gzip), 2 (Snappy), 3 (LZ4), 4 (Zstd)
KAFKA_COMPRESSION=2

KAFKA_DIAL_TIMEOUT=10s
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s
KAFKA_RETRY_MAX=3
KAFKA_RETRY_BACKOFF=100ms

# Security
JWT_

CONFIRMATION_CODE_EXPIRY=15m

# JWT Token Durations
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# Cookie Settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax